model CommissionSlab {
  id                 String                           @id @default(uuid())
  slabNumber         Int                              @unique
  name               String
  monthlySalesTarget Decimal                          @db.Decimal(14, 2)
  commissionRate     Decimal                          @db.Decimal(5, 2)
  commissionAtTarget Decimal                          @db.Decimal(14, 2)
  achievementBonus   Decimal                          @db.Decimal(14, 2)
  basicSalary        Decimal                          @db.Decimal(14, 2)
  active             Boolean                          @default(true)
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  monthlyProgress    StaffMonthlyCommissionProgress[]
  users              User[]

  @@map("commission_slabs")
}

model StaffMonthlyCommissionProgress {
  id                 String          @id @default(uuid())
  staffId            String
  year               Int
  month              Int
  currentSlabId      String?
  totalAchievedSales Decimal         @default(0) @db.Decimal(14, 2)
  slab1Achieved      Boolean         @default(false)
  slab1AchievedAt    DateTime?
  slab2Achieved      Boolean         @default(false)
  slab2AchievedAt    DateTime?
  slab3Achieved      Boolean         @default(false)
  slab3AchievedAt    DateTime?
  earnedCommission   Decimal         @default(0) @db.Decimal(14, 2)
  earnedBonus        Decimal         @default(0) @db.Decimal(14, 2)
  basicSalary        Decimal         @default(1500) @db.Decimal(14, 2)
  totalPayout        Decimal         @default(0) @db.Decimal(14, 2)
  status             String          @default("ACTIVE")
  assignedAt         DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  currentSlab        CommissionSlab? @relation(fields: [currentSlabId], references: [id])
  staff              User            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, year, month])
  @@index([year, month])
  @@map("staff_monthly_commission_progress")
}

model CommissionRule {
  id            String   @id @default(uuid())
  name          String
  rate          Decimal  @db.Decimal(5, 2)
  appliesToRole Role     @default(SALES_STAFF)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("commission_rules")
}

model Commission {
  id               String           @id @default(uuid())
  staffId          String
  proposalId       String?
  invoiceId        String?
  commissionRate   Decimal          @db.Decimal(5, 2)
  commissionAmount Decimal          @db.Decimal(14, 2)
  status           CommissionStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  proposal         Proposal?        @relation(fields: [proposalId], references: [id])
  staff            User             @relation(fields: [staffId], references: [id])

  @@map("commissions")
}
