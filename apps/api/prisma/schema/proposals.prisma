model Proposal {
  id                   String         @id @default(uuid())
  proposalNumber       String         @unique
  leadId               String?
  clientId             String?
  salesStaffId         String
  status               ProposalStatus @default(DRAFT)
  subtotal             Decimal        @db.Decimal(14, 2)
  discount             Decimal        @db.Decimal(14, 2) @default(0)
  tax                  Decimal        @db.Decimal(14, 2) @default(0)
  total                Decimal        @db.Decimal(14, 2)
  expectedDeliveryDate DateTime?
  projectDescription   String?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  lead        Lead?    @relation(fields: [leadId], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id])
  salesStaff  User     @relation("ProposalSalesStaff", fields: [salesStaffId], references: [id])

  items         ProposalItem[]
  statusHistory ProposalStatusHistory[]
  invoices      Invoice[]
  commissions   Commission[]
  contracts     Contract[]

  @@index([status])
  @@index([salesStaffId])
  @@map("proposals")
}

model ProposalItem {
  id         String           @id @default(uuid())
  proposalId String
  itemType   ProposalItemType
  packageId  String?
  addonId    String?
  name       String
  quantity   Int              @default(1)
  unitPrice  Decimal          @db.Decimal(14, 2)
  total      Decimal          @db.Decimal(14, 2)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  package  Package? @relation("PackageProposalItems", fields: [packageId], references: [id])
  addon    Addon?   @relation("AddonProposalItems", fields: [addonId], references: [id])

  @@map("proposal_items")
}

model ProposalStatusHistory {
  id         String         @id @default(uuid())
  proposalId String
  fromStatus ProposalStatus?
  toStatus   ProposalStatus
  changedBy  String
  note       String?
  createdAt  DateTime       @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_status_history")
}
